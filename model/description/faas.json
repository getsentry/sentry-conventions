{
  "brief": "Serverless (FAAS)",
  "operations": [
    {
      "name": "GCP Serverless function execution",
      "brief": "The invocation of a GCP serverless function.",
      "ops": ["function.gcp"],
      "templates": [
        "{{gcp.function.context.type}}",
        "{{gcp.function.context.event_type}}",
        "{{http.request.method}} {{url.path}}",
        "{{faas.name}}"
      ],
      "examples": [
        "google.cloud.pubsub.topic.v1.messagePublished",
        "providers/cloud.firestore/eventTypes/document.write",
        "POST /path",
        "my_function",
        "process-upload"
      ]
    },
    {
      "name": "Serverless function execution",
      "brief": "The invocation of a serverless function on a cloud provider.",
      "ops": ["function.aws", "function.azure"],
      "templates": ["{{faas.name}} {{http.request.method}} {{http.route}}", "{{faas.name}}"],
      "examples": ["checkout GET /orders/{id}", "my_function", "process-upload"]
    }
  ]
}
