{
  "brief": "Serverless (FAAS)",
  "operations": [
    {
      "name": "GCP Serverless function execution",
      "brief": "The invocation of a GCP serverless function.",
      "ops": ["function.gcp"],
      "templates": [
        "{{gcp.function.context.type}}",
        "{{gcp.function.context.event_type}}",
        "{{http.request.method}} {{url.path}}",
        "{{faas.name}}"
      ],
      "examples": [
        "google.cloud.pubsub.topic.v1.messagePublished",
        "providers/cloud.firestore/eventTypes/document.write",
        "POST /path",
        "my_function",
        "process-upload"
      ]
    },
    {
      "name": "Azure Serverless function execution",
      "brief": "The invocation of an Azure serverless function.",
      "ops": ["function.azure"],
      "templates": ["{{faas.name}}"],
      "examples": ["my_function", "process-upload"]
    },
    {
      "name": "AWS Lambda function execution",
      "brief": "The invocation of an AWS Lambda function.",
      "ops": ["function.aws"],
      "templates": ["{{faas.name}} {{http.request.method}} {{http.route}}"],
      "examples": ["checkout GET /orders/{id}"]
    }
  ]
}
