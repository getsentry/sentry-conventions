{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SpanName",
  "definitions": {
    "SpanName": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpanOperation"
          }
        }
      },
      "required": ["brief", "operations"],
      "additionalProperties": false,
      "title": "SpanName"
    },
    "SpanOperation": {
      "anyOf": [
        {
          "$ref": "#/definitions/OtelSpanOperation"
        },
        {
          "$ref": "#/definitions/NonOtelSpanOperation"
        }
      ],
      "title": "SpanOperation"
    },
    "OtelSpanOperation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_in_otel": {
          "type": "boolean",
          "const": true
        },
        "otel_notes": {
          "type": "string"
        }
      },
      "required": ["brief", "ops", "templates", "is_in_otel", "otel_notes"],
      "additionalProperties": false,
      "title": "SpanOperation"
    },
    "NonOtelSpanOperation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_in_otel": {
          "type": "boolean",
          "const": false
        },
        "otel_notes": {
          "type": "string"
        }
      },
      "required": ["brief", "ops", "templates", "is_in_otel"],
      "additionalProperties": false,
      "title": "SpanOperation"
    }
  }
}
