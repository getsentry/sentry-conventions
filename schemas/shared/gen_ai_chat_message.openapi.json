{
  "openapi": "3.2.1",
  "info": {
    "title": "GenAI Chat Message",
    "description": "Chat message schema shared by the GenAI input and output message attributes.",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "ChatMessage": {
        "description": "Represents a message sent to or generated by the model or agent.",
        "x-otel-deviation": [
          "OTel names this definition InputMessage or OutputMessage.",
          "OTel allows arbitrary additional properties, while this definition does not."
        ],
        "properties": {
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "string"
              }
            ],
            "description": "Role of the entity that created the message."
          },
          "parts": {
            "description": "List of message parts that make up the message content.",
            "items": {
              "x-otel-deviation": [
                "OTel's TranscriptionPart is omitted. Transcripts are dropped and may be captured as part of existing audio parts in the future.",
                "OTel's ServerToolCallPart and ServerToolCallResponsePart are omitted due to overlap with GenericPart. Server-side tool calls and results are recorded as GenericPart."
              ],
              "anyOf": [
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/TextPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/ToolCallRequestPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/ToolCallResponsePart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/BlobPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/FilePart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/UriPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/ReasoningPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/CompactionPart"
                },
                {
                  "$ref": "./gen_ai_parts.openapi.json#/components/schemas/GenericPart"
                }
              ]
            },
            "type": "array"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The name of the participant."
          }
        },
        "additionalProperties": false,
        "required": ["role", "parts"],
        "type": "object"
      },
      "Role": {
        "enum": ["system", "user", "assistant", "tool"],
        "type": "string"
      }
    }
  }
}
