---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributeCard from '../../components/AttributeCard.astro';
import AttributeFilters from '../../components/AttributeFilters.svelte';
import { getCollection, render } from 'astro:content';
import { parseAttributeId } from '../../utils/category';
import { renderInlineMarkdown } from '../../utils/markdown';

export async function getStaticPaths() {
  const allAttributes = await getCollection('attributes');
  // Namespace READMEs (model/attributes/<category>/README.md), keyed by category
  const namespaces = new Map((await getCollection('namespaces')).map((namespace) => [namespace.id, namespace]));

  // Build category map
  const categoryMap = new Map<string, typeof allAttributes>();

  for (const attr of allAttributes) {
    const { category } = parseAttributeId(attr.id);

    if (!categoryMap.has(category)) {
      categoryMap.set(category, []);
    }
    categoryMap.get(category)?.push(attr);
  }

  // Sort categories alphabetically, but put 'general' first
  const sortedCategories = Array.from(categoryMap.keys()).sort((a, b) => {
    if (a === 'general') return -1;
    if (b === 'general') return 1;
    return a.localeCompare(b);
  });

  // Generate paths for each category
  return Array.from(categoryMap.entries()).map(([category, attributes]) => ({
    params: { category },
    props: { attributes, allCategories: sortedCategories, namespace: namespaces.get(category) },
  }));
}

interface Props {
  attributes: Awaited<ReturnType<typeof getCollection<'attributes'>>>;
  allCategories: string[];
  namespace: Awaited<ReturnType<typeof getCollection<'namespaces'>>>[number] | undefined;
}

const { category } = Astro.params;
const { attributes, allCategories, namespace } = Astro.props;

// Sort attributes: stable first, then deprecated, both alphabetically
const stableAttributes = attributes
  .filter((a) => !a.data.deprecation)
  .sort((a, b) => a.data.key.localeCompare(b.data.key));

const deprecatedAttributes = attributes
  .filter((a) => a.data.deprecation)
  .sort((a, b) => a.data.key.localeCompare(b.data.key));

const totalCount = attributes.length;
const stableCount = stableAttributes.length;
const deprecatedCount = deprecatedAttributes.length;

// Format category name for display
const categoryTitle = category.charAt(0).toUpperCase() + category.slice(1);

const NamespaceBody = namespace?.body?.trim() ? (await render(namespace)).Content : undefined;
// Everything but the brief is collapsed behind a toggle
const hasNamespaceDetails = Boolean(namespace?.data.includes || namespace?.data.excludes || NamespaceBody);
---

<BaseLayout 
  title={`${categoryTitle} Attributes`} 
  description={`Browse ${totalCount} ${category} attributes in Sentry semantic conventions`}
>
  <div class="flex gap-8">
    <aside class="hidden lg:block flex-shrink-0 w-40 sticky top-[calc(64px+1.5rem)] max-h-[calc(100vh-64px-3rem)] overflow-y-auto self-start">
      <h3 class="text-sm text-text-muted uppercase tracking-wider mb-3">Categories</h3>
      <nav class="flex flex-col gap-1">
        <a 
          href={`${import.meta.env.BASE_URL}attributes/`}
          class="text-sm px-2 py-1 rounded-sm transition-fast text-text-secondary hover:bg-bg-hover hover:text-text-primary"
        >
          All
        </a>
        {allCategories.map(cat => (
          <a 
            href={`${import.meta.env.BASE_URL}attributes/${cat}/`}
            class:list={[
              "text-sm px-2 py-1 rounded-sm transition-fast",
              cat === category
                ? "bg-accent-soft text-accent"
                : "text-text-secondary hover:bg-bg-hover hover:text-text-primary"
            ]}
          >
            {cat}
          </a>
        ))}
      </nav>
    </aside>
    
    <div class="flex-1 min-w-0">
      <nav class="breadcrumb">
        <a href={`${import.meta.env.BASE_URL}attributes/`}>Attributes</a>
        <span class="separator">/</span>
        <span class="current">{category}</span>
      </nav>
      
      <div class="mb-8">
        <h1>{categoryTitle} Attributes</h1>
        <p class="text-lg text-text-secondary flex items-center gap-2 flex-wrap">
          {totalCount} attribute{totalCount !== 1 ? 's' : ''} in this category.
          {stableCount > 0 && <span class="text-pii-false">{stableCount} stable</span>}
          {stableCount > 0 && deprecatedCount > 0 && <span class="text-text-muted">·</span>}
          {deprecatedCount > 0 && <span class="text-text-muted">{deprecatedCount} deprecated</span>}
        </p>
      </div>

      {namespace && (
        <section class="mb-8">
          <p class="text-text-primary leading-relaxed" set:html={renderInlineMarkdown(namespace.data.brief)} />
          {hasNamespaceDetails && (
            <details class="mt-3 group">
              <summary class="cursor-pointer list-none flex items-center gap-2 text-sm text-text-muted transition-colors duration-fast hover:text-text-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-fast group-open:rotate-90">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
                What belongs in this namespace
              </summary>
              <div class="mt-4 flex flex-col gap-4">
                {(namespace.data.includes || namespace.data.excludes) && (
                  <div class="grid gap-4 sm:grid-cols-2">
                    {namespace.data.includes && (
                      <div>
                        <h3 class="text-sm text-text-muted uppercase tracking-wider mb-2">Belongs here</h3>
                        <ul class="flex flex-col gap-1.5 mb-0 list-disc list-outside text-sm text-text-secondary">
                          {namespace.data.includes.map((include) => (
                            <li class="mb-0" set:html={renderInlineMarkdown(include)} />
                          ))}
                        </ul>
                      </div>
                    )}
                    {namespace.data.excludes && (
                      <div>
                        <h3 class="text-sm text-text-muted uppercase tracking-wider mb-2">Does not belong here</h3>
                        <ul class="flex flex-col gap-1.5 mb-0 list-disc list-outside text-sm text-text-secondary">
                          {namespace.data.excludes.map((exclude) => (
                            <li class="mb-0">
                              <span set:html={renderInlineMarkdown(exclude.description)} />
                              {' → '}
                              <a
                                href={`${import.meta.env.BASE_URL}attributes/${exclude.see.split('.')[0]}/`}
                                class="text-accent hover:text-accent-hover"
                              >
                                <code class="text-xs">{exclude.see}</code>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}
                {NamespaceBody && (
                  <div class="namespace-body text-sm text-text-secondary leading-relaxed">
                    <NamespaceBody />
                  </div>
                )}
              </div>
            </details>
          )}
        </section>
      )}

      <AttributeFilters client:load mode="cards" totalCount={totalCount} />

      <div
        id="attribute-filter-empty"
        class="hidden mb-8 p-6 bg-bg-secondary border border-dashed border-border rounded-lg text-center text-text-muted"
      >
        No attributes match the current filters.
      </div>
      
      <div id="attribute-list" class="flex flex-col gap-12">
        {stableAttributes.length > 0 && (
          <section data-attribute-section>
            <h2 class="mb-4 pb-3 border-b border-border">Stable Attributes</h2>
            <div class="flex flex-col gap-4">
              {stableAttributes.map(attr => (
                <AttributeCard attribute={attr.data} id={attr.id} />
              ))}
            </div>
          </section>
        )}
        
        {deprecatedAttributes.length > 0 && (
          <section class="opacity-90" data-attribute-section>
            <h2 class="mb-4 pb-3 border-b border-border text-text-muted">Deprecated Attributes</h2>
            <p class="text-sm text-text-muted mb-6">
              These attributes are deprecated and should not be used in new code. 
              See each attribute for migration guidance.
            </p>
            <div class="flex flex-col gap-4">
              {deprecatedAttributes.map(attr => (
                <AttributeCard attribute={attr.data} id={attr.id} />
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .namespace-body :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
