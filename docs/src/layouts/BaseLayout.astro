---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';
import SearchIcon from '../components/icons/SearchIcon.astro';
import ExternalLinkIcon from '../components/icons/ExternalLinkIcon.astro';
import SentryLogo from '../components/icons/SentryLogo.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sentry Semantic Conventions - Standardized naming for attributes and spans' } =
  Astro.props;
const currentPath = Astro.url.pathname;
// Link unfurlers (Slack, GitHub, ...) need absolute URLs. `Astro.url` is the `site` URL in builds
// and the actual host in dev; `pathname` already includes the base path.
const canonicalUrl = new URL(currentPath, Astro.url).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.url).href;

const base = import.meta.env.BASE_URL;
const isHome = currentPath === base || currentPath === base + '/';
const navItems = [
  { label: 'Home', href: base, active: isHome },
  { label: 'Attributes', href: `${base}attributes/`, active: currentPath.includes('/attributes') },
  { label: 'Span Names', href: `${base}names/`, active: currentPath.includes('/names') },
  { label: 'Span Descriptions', href: `${base}descriptions/`, active: currentPath.includes('/descriptions') },
  { label: 'Span Operations', href: `${base}ops/`, active: currentPath.includes('/ops') },
  { label: 'Metrics', href: `${base}metrics/`, active: currentPath.includes('/metrics') },
];
const githubUrl = 'https://github.com/getsentry/sentry-conventions';
const navLinkActive = 'text-accent bg-accent-soft';
const navLinkInactive = 'text-text-secondary hover:text-text-primary hover:bg-bg-hover';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sentry Conventions" />
    <meta property="og:title" content={`${title} | Sentry Conventions`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Sentry logo" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}sentry-glyph.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title} | Sentry Conventions</title>
    <script is:inline>
      // Initialize theme before render to prevent flash
      const theme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'dark' || (!theme && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <header class="sticky top-0 z-50 h-header bg-bg-secondary border-b border-border backdrop-blur-sm">
        <div class="max-w-content mx-auto px-6 h-full flex items-center justify-between gap-8">
          <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-3 text-text-primary font-semibold text-lg transition-colors duration-fast hover:text-accent">
            <SentryLogo size={28} />
            <span class="hidden md:inline">Sentry Conventions</span>
          </a>
          
          <nav class="hidden xl:flex items-center gap-2" aria-label="Main">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={['nav-link', item.active ? navLinkActive : navLinkInactive]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
            <a href={githubUrl} class:list={['nav-link', navLinkInactive]} target="_blank" rel="noopener">
              GitHub
              <ExternalLinkIcon />
            </a>
          </nav>
          
          <div class="flex items-center gap-2">
            <button
              class="flex items-center gap-3 px-3 py-2 bg-bg-elevated border border-border rounded-md text-text-muted text-sm cursor-pointer transition-fast hover:border-border-light hover:text-text-secondary"
              id="search-trigger"
              aria-label="Search"
            >
              <SearchIcon />
              <span class="hidden md:flex gap-1">
                <kbd class="inline-flex items-center justify-center min-w-[20px] h-5 px-1 bg-bg-secondary border border-border rounded-sm font-sans text-xs font-medium">⌘</kbd>
                <kbd class="inline-flex items-center justify-center min-w-[20px] h-5 px-1 bg-bg-secondary border border-border rounded-sm font-sans text-xs font-medium">K</kbd>
              </span>
            </button>
            <ThemeToggle client:load />
            <div class="relative xl:hidden" id="nav-menu">
              <button
                type="button"
                id="nav-menu-trigger"
                class="flex items-center justify-center w-9 h-9 bg-bg-elevated border border-border rounded-md text-text-secondary cursor-pointer transition-all duration-fast hover:border-border-light hover:text-text-primary"
                aria-label="Open navigation menu"
                aria-expanded="false"
                aria-controls="nav-menu-panel"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="4" y1="6" x2="20" y2="6" />
                  <line x1="4" y1="12" x2="20" y2="12" />
                  <line x1="4" y1="18" x2="20" y2="18" />
                </svg>
              </button>
              <nav
                id="nav-menu-panel"
                class="hidden absolute right-0 top-full mt-2 w-56 flex-col gap-1 p-2 bg-bg-elevated border border-border rounded-md shadow-lg"
                aria-label="Main"
              >
                {navItems.map((item) => (
                  <a
                    href={item.href}
                    class:list={['nav-link', item.active ? navLinkActive : navLinkInactive]}
                    aria-current={item.active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
                <a href={githubUrl} class:list={['nav-link', navLinkInactive]} target="_blank" rel="noopener">
                  GitHub
                  <ExternalLinkIcon />
                </a>
              </nav>
            </div>
          </div>
        </div>
      </header>
      
      <main class="flex-1 w-full max-w-content mx-auto py-8 px-6 md:px-6">
        <slot />
      </main>
      
      <footer class="mt-auto py-6 px-6 bg-bg-secondary border-t border-border">
        <div class="max-w-content mx-auto text-center">
          <p class="text-sm text-text-muted mb-2">&copy; {new Date().getFullYear()} Sentry. Licensed under MIT.</p>
          <p class="flex items-center justify-center gap-2 text-sm">
            <a href="https://github.com/getsentry/sentry-conventions/blob/main/CONTRIBUTING.md" class="text-text-secondary hover:text-accent" target="_blank" rel="noopener">Contributing</a>
            <span class="text-text-muted">·</span>
            <a href="https://github.com/getsentry/sentry-conventions/issues" class="text-text-secondary hover:text-accent" target="_blank" rel="noopener">Report Issue</a>
            <span class="text-text-muted">·</span>
            <a href={`${import.meta.env.BASE_URL}llms.txt`} class="text-text-secondary hover:text-accent">llms.txt</a>
            <span class="text-text-muted">·</span>
            <a href={`${import.meta.env.BASE_URL}llms-full.txt`} class="text-text-secondary hover:text-accent">llms-full.txt</a>
          </p>
        </div>
      </footer>
    </div>
    
    <!-- Search modal - Svelte island -->
    <SearchModal client:load />

    <script>
      const menu = document.getElementById('nav-menu');
      const trigger = document.getElementById('nav-menu-trigger');
      const panel = document.getElementById('nav-menu-panel');

      if (menu && trigger && panel) {
        const setOpen = (open: boolean) => {
          panel.classList.toggle('hidden', !open);
          panel.classList.toggle('flex', open);
          trigger.setAttribute('aria-expanded', String(open));
          trigger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        };

        trigger.addEventListener('click', () => {
          setOpen(trigger.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target as Node)) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            trigger.focus();
          }
        });
      }
    </script>
  </body>
</html>
