---
import { attributeUrl } from '../utils/attributeUrl';
import DottedName from './DottedName.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const href = attributeUrl(name, import.meta.env.BASE_URL);
---

<a href={href} class="text-accent hover:text-accent-hover"><code class="text-xs"><DottedName name={name} /></code></a>
