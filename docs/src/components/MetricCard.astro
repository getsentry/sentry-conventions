---
import OtelBadge from './OtelBadge.astro';
import TypeBadge from './TypeBadge.astro';
import AttributeLink from './AttributeLink.astro';
import type { Metric } from '../content.config';
import { renderInlineMarkdown } from '../utils/markdown';

interface Props {
  metric: Metric;
}

const { metric } = Astro.props;

const anchorId = metric.key.replace(/\./g, '-');
const rawJson = JSON.stringify(metric, null, 2);

const requirementLabels = {
  required: 'Required',
  recommended: 'Recommended',
  opt_in: 'Opt-in',
};
---

<article
  class="bg-bg-secondary border border-border rounded-lg p-5 transition-colors duration-fast scroll-mt-24 hover:border-border-light"
  id={anchorId}
  data-pagefind-body
>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
    <h3 class="flex items-center gap-2 text-base m-0" data-pagefind-meta="title">
      <a href={`#${anchorId}`} class="anchor-link group/anchor flex items-center gap-1.5 no-underline">
        <code class="text-base p-0 bg-transparent border-none text-accent">{metric.key}</code>
        <svg class="anchor-icon w-4 h-4 text-text-muted opacity-0 group-hover/anchor:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
      </a>
    </h3>
    <div class="flex flex-wrap items-center gap-2">
      <TypeBadge type={metric.instrument} />
      <OtelBadge isInOtel={metric.is_in_otel} />
    </div>
  </div>

  <p class="text-sm text-text-secondary mb-4 leading-relaxed" set:html={renderInlineMarkdown(metric.brief)} />

  <div class="flex flex-col gap-2">
    <div class="flex items-baseline gap-3 text-sm">
      <span class="text-text-muted min-w-[100px] flex-shrink-0">Unit</span>
      <code class="text-xs">{metric.unit}</code>
    </div>

    <div class="flex items-baseline gap-3 text-sm">
      <span class="text-text-muted min-w-[100px] flex-shrink-0">Requirement</span>
      <span class="text-text-secondary">{requirementLabels[metric.requirement_level]}</span>
    </div>

    {metric.attributes && metric.attributes.length > 0 && (
      <div class="flex items-baseline gap-3 text-sm">
        <span class="text-text-muted min-w-[100px] flex-shrink-0">Attributes</span>
        <span class="flex flex-wrap gap-1">
          {metric.attributes.map((attribute) => <AttributeLink name={attribute} />)}
        </span>
      </div>
    )}
  </div>

  <details class="mt-4 pt-3 border-t border-border group">
    <summary class="cursor-pointer list-none flex items-center gap-2 text-sm text-text-muted transition-colors duration-fast hover:text-text-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-fast group-open:rotate-90">
        <path d="M9 18l6-6-6-6"/>
      </svg>
      Raw JSON
    </summary>
    <pre class="mt-3 m-0 p-4 bg-bg-elevated border border-border rounded-md overflow-x-auto text-xs"><code class="text-text-secondary">{rawJson}</code></pre>
  </details>
</article>
